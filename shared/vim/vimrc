" Cross-platform vim configuration.
" Works on Linux, macOS and Windows (gvim reads ~/.vimrc / $HOME/_vimrc).

set nocompatible

set backspace=indent,eol,start
set softtabstop=4
set shiftwidth=4
set number
set relativenumber
set expandtab

filetype indent plugin on
syntax on
set showcmd
set ignorecase
set smartcase
set autoindent
set ruler
set laststatus=2
set scrolloff=999

" Templates for new files.
autocmd BufNewFile *.c 0r ~/.vim/templates/template.c
autocmd BufNewFile solution.py 0r ~/.vim/templates/solution_template.py

if has('persistent_undo')
    if !isdirectory($HOME . '/.vim/undo')
        call mkdir($HOME . '/.vim/undo', 'p', 0700)
    endif
    set undofile
    set undodir=$HOME/.vim/undo
endif

" Machine- or OS-specific overrides, kept out of version control.
if filereadable(expand('~/.vimrc.local'))
    source ~/.vimrc.local
endif
