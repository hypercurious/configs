# Shared git configuration.
# Identity lives in ~/.gitconfig.local so this file stays machine-agnostic.
[push]
	autoSetupRemote = true
[core]
	editor = vim
	excludesfile = ~/.gitignore_global
[alias]
	ap = add --patch
	st = status --short --branch
	lg = log --oneline --graph --decorate
	last = log -1 --stat
	fb = "!f() { git branch -a | grep -i -- \"$1\"; }; f"
[init]
	defaultBranch = main
[pull]
	rebase = false
[diff]
	colorMoved = default
[include]
	path = ~/.gitconfig.local
