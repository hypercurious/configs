{
  "$schema": "https://schema.linearmouse.app/0.11.4",
  "schemes": [
    {
      "if": {
        "device": {
          "category": "mouse",
          "productID": "0x1729",
          "productName": "SteelSeries Rival 110 Gaming Mouse",
          "vendorID": "0x1038"
        }
      },
      "pointer": {
        "acceleration": 1,
        "disableAcceleration": true
      },
      "scrolling": {
        "acceleration": {
          "vertical": 1
        },
        "distance": {
          "vertical": 2
        },
        "reverse": true,
        "smoothed": {
          "vertical": {
            "enabled": false
          }
        },
        "speed": {
          "vertical": 0
        }
      }
    },
    {
      "buttons": {
        "universalBackForward": false
      },
      "if": {
        "device": {
          "category": "trackpad",
          "productID": "0x0",
          "productName": "Apple Internal Keyboard / Trackpad",
          "vendorID": "0x0"
        }
      },
      "pointer": {
        "disableAcceleration": false
      },
      "scrolling": {
        "acceleration": {
          "vertical": 1
        },
        "distance": {
          "vertical": "auto"
        },
        "reverse": false,
        "smoothed": {
          "vertical": {
            "enabled": false
          }
        },
        "speed": {
          "vertical": 0
        }
      }
    },
    {
      "if": {
        "device": {
          "category": "mouse",
          "productID": "0x98",
          "productName": "Razer DeathAdder Essential",
          "vendorID": "0x1532"
        }
      },
      "pointer": {
        "disableAcceleration": true
      },
      "scrolling": {
        "acceleration": 1,
        "distance": {
          "horizontal": 2,
          "vertical": 3
        },
        "reverse": true,
        "smoothed": {
          "enabled": false
        },
        "speed": 0
      }
    },
    {
      "if": {
        "device": {
          "category": "mouse",
          "productID": "0x301a",
          "productName": "Dell MS116 USB Optical Mouse",
          "vendorID": "0x413c"
        }
      },
      "pointer": {
        "acceleration": 1,
        "disableAcceleration": true
      },
      "scrolling": {
        "acceleration": {
          "vertical": 1
        },
        "distance": {
          "vertical": "63.1px"
        },
        "reverse": {
          "vertical": true
        },
        "smoothed": {
          "vertical": {
            "enabled": false
          }
        },
        "speed": {
          "vertical": 0
        }
      }
    }
  ]
}
